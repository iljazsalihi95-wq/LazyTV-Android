NODE_ENV=production
PORT=8080
DATABASE_PATH=./data/lazytv.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_SECURE=true
TRUST_PROXY=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-on-first-initialization

# Google Sheet is the activation source of truth.
GOOGLE_SPREADSHEET_ID=10nGqO-yR3QgC0n0D4jksuQRhNaYD5FRkWoOGSH2VlY8
# Server-side service account only. Share the spreadsheet with this account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account-name@project-id.iam.gserviceaccount.com
# Keep the real private key only in the deployment environment/secret manager.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n"

# Used only when auto-registering a brand-new Android identity in CLIENTS.
DEFAULT_PACKAGE=FULL
MAX_DEVICES_DEFAULT=1
PUBLIC_INACTIVE_MESSAGE=Waiting for activation.
