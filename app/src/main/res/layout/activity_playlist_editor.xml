<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/lazytv_background"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shto / Edito Playlist" android:textColor="@android:color/white" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Lloji" android:textColor="@color/lazytv_muted"/><Spinner android:id="@+id/type_spinner" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_input"/>
<EditText android:id="@+id/input_name" style="@style/LazyInput" android:hint="Name / Emri"/>
<LinearLayout android:id="@+id/url_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><EditText android:id="@+id/input_url" style="@style/LazyInput" android:hint="Server / Portal / M3U URL" android:inputType="textUri"/></LinearLayout>
<LinearLayout android:id="@+id/file_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><Button android:id="@+id/pick_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Zgjidh skedarin M3U" android:textAllCaps="false"/><TextView android:id="@+id/file_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Asnjë skedar" android:textColor="@color/lazytv_muted"/></LinearLayout>
<LinearLayout android:id="@+id/xtream_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><EditText android:id="@+id/input_username" style="@style/LazyInput" android:hint="Username"/><EditText android:id="@+id/input_password" style="@style/LazyInput" android:hint="Password" android:inputType="textPassword"/></LinearLayout>
<LinearLayout android:id="@+id/stalker_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><EditText android:id="@+id/input_mac" style="@style/LazyInput" android:hint="MAC / Device identifier"/></LinearLayout>
<Button android:id="@+id/save_playlist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Ruaj Playlistën" android:textAllCaps="false"/>
</LinearLayout></ScrollView>
