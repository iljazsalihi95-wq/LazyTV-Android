<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#030A12">
 <LinearLayout android:id="@+id/live_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="6dp">
  <LinearLayout android:id="@+id/live_left_panel" android:layout_width="0dp" android:layout_weight="22" android:layout_height="match_parent" android:orientation="vertical" android:background="#071522">
   <TextView android:text="LIVE TV" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <TextView android:text="COUNTRIES" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <Spinner android:id="@+id/live_country_spinner" android:focusable="true" android:clickable="true" android:spinnerMode="dropdown" android:background="@drawable/bg_input" android:padding="6dp" android:layout_width="match_parent" android:layout_height="48dp"/>
   <TextView android:text="CATEGORIES" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <ListView android:id="@+id/live_categories" android:listSelector="@drawable/bg_live_row" android:dividerHeight="0dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/live_channel_panel" android:layout_width="0dp" android:layout_weight="23" android:layout_height="match_parent" android:orientation="vertical" android:background="#0A1B2B" android:layout_marginStart="5dp">
   <EditText android:id="@+id/live_search" android:hint="Search channels…" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#8198AB" android:background="@drawable/bg_input" android:padding="9dp" android:layout_width="match_parent" android:layout_height="44dp"/>
   <ListView android:id="@+id/live_channels" android:listSelector="@drawable/bg_live_row" android:divider="#173047" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
  <FrameLayout android:id="@+id/live_player_panel" android:layout_width="0dp" android:layout_weight="55" android:layout_height="match_parent" android:layout_marginStart="5dp" android:background="#000000">
   <androidx.media3.ui.PlayerView android:id="@+id/live_player" android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true" app:use_controller="false" app:show_buffering="never"/>
   <ProgressBar android:id="@+id/live_loading" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:visibility="gone"/>
   <LinearLayout android:id="@+id/live_info" android:layout_gravity="bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="#C0000000">
    <TextView android:id="@+id/live_title" android:text="Zgjidh një kanal" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/live_epg" android:text="EPG shfaqet kur ofrohet nga burimi" android:maxLines="3" android:ellipsize="end" android:textColor="#B8C9D8" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/live_favorite" android:text="☆ Favorite" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/live_fullscreen" android:text="⛶ Fullscreen" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
   </LinearLayout>
  </FrameLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/live_overlay" android:visibility="gone" android:layout_width="700dp" android:layout_height="match_parent" android:layout_gravity="start" android:orientation="horizontal" android:padding="8dp" android:background="#E807121D">
  <LinearLayout android:layout_width="0dp" android:layout_weight="42" android:layout_height="match_parent" android:orientation="vertical"><TextView android:text="CATEGORIES" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/overlay_categories" android:listSelector="@drawable/bg_live_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="58" android:layout_height="match_parent" android:orientation="vertical"><TextView android:text="CHANNELS" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/overlay_channels" android:listSelector="@drawable/bg_live_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/live_status" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</FrameLayout>