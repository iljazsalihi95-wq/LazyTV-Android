<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#020611">

 <LinearLayout android:id="@+id/live_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

  <LinearLayout android:id="@+id/live_top_bar" android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:background="#071426">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAZYTV PRO" android:textColor="#FF7A18" android:textSize="24sp" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="28dp" android:text="● LIVE TV" android:textColor="#19D7FF" android:textSize="16sp" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="MOVIES" android:textColor="#AAB7CA" android:textSize="15sp" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="SERIES" android:textColor="#AAB7CA" android:textSize="15sp" android:textStyle="bold"/>
   <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SERVER 05" android:textColor="#FF9A2F" android:textStyle="bold" android:textSize="14sp"/>
  </LinearLayout>

  <LinearLayout android:id="@+id/live_content_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:padding="8dp">

   <LinearLayout android:id="@+id/live_left_panel" android:layout_width="0dp" android:layout_weight="22" android:layout_height="match_parent" android:orientation="vertical" android:background="#071522" android:padding="8dp">
    <TextView android:text="COUNTRIES" android:textColor="#18D7FF" android:textStyle="bold" android:textSize="13sp" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Spinner android:id="@+id/live_country_spinner" android:focusable="true" android:clickable="true" android:spinnerMode="dropdown" android:background="@drawable/bg_input" android:padding="6dp" android:layout_width="match_parent" android:layout_height="46dp"/>
    <TextView android:text="CATEGORIES" android:textColor="#18D7FF" android:textStyle="bold" android:textSize="13sp" android:paddingTop="10dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/live_categories" android:listSelector="@drawable/bg_live_row" android:dividerHeight="0dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
   </LinearLayout>

   <LinearLayout android:id="@+id/live_channel_panel" android:layout_width="0dp" android:layout_weight="30" android:layout_height="match_parent" android:orientation="vertical" android:background="#091A2C" android:layout_marginStart="6dp" android:padding="6dp">
    <EditText android:id="@+id/live_search" android:hint="Search channels…" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#7890A7" android:background="@drawable/bg_input" android:padding="9dp" android:layout_width="match_parent" android:layout_height="44dp"/>
    <ListView android:id="@+id/live_channels" android:listSelector="@drawable/bg_live_row" android:divider="#173047" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
   </LinearLayout>

   <FrameLayout android:id="@+id/live_player_panel" android:layout_width="0dp" android:layout_weight="48" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/live_player" android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true" app:use_controller="false" app:show_buffering="never"/>
    <ImageView android:id="@+id/live_loading_logo" android:layout_width="130dp" android:layout_height="130dp" android:layout_gravity="center" android:scaleType="fitCenter" android:visibility="gone"/>
    <LinearLayout android:id="@+id/live_idle" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
     <ImageView android:id="@+id/live_idle_logo" android:layout_width="190dp" android:layout_height="190dp" android:scaleType="fitCenter"/>
     <TextView android:text="Zgjidh një kanal" android:textColor="#DDE7F0" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/live_info" android:layout_gravity="bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="#D0000814">
     <TextView android:id="@+id/live_title" android:text="LazyTV PRO • LIVE TV" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
     <TextView android:id="@+id/live_epg" android:text="SERVER 05 • EPG" android:maxLines="3" android:ellipsize="end" android:textColor="#AFC6D8" android:layout_width="match_parent" android:layout_height="wrap_content"/>
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <Button android:id="@+id/live_favorite" android:text="☆ Favorite" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      <Button android:id="@+id/live_fullscreen" android:text="⛶ Fullscreen" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
     </LinearLayout>
    </LinearLayout>
   </FrameLayout>
  </LinearLayout>

  <TextView android:id="@+id/live_bottom_bar" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:paddingStart="16dp" android:text="LazyTV PRO  •  LIVE TV  •  MOVIES  •  SERIES  •  SERVER 05" android:textColor="#71859A" android:textSize="11sp" android:background="#06111E"/>
 </LinearLayout>

 <LinearLayout android:id="@+id/live_overlay" android:visibility="gone" android:layout_width="560dp" android:layout_height="match_parent" android:layout_gravity="start" android:orientation="horizontal" android:padding="8dp" android:background="#F007121D">
  <LinearLayout android:layout_width="0dp" android:layout_weight="42" android:layout_height="match_parent" android:orientation="vertical">
   <TextView android:text="CATEGORIES" android:textColor="#18D7FF" android:textStyle="bold" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <ListView android:id="@+id/overlay_categories" android:listSelector="@drawable/bg_live_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="58" android:layout_height="match_parent" android:orientation="vertical">
   <TextView android:text="CHANNELS" android:textColor="#18D7FF" android:textStyle="bold" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <ListView android:id="@+id/overlay_channels" android:listSelector="@drawable/bg_live_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/live_status" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</FrameLayout>