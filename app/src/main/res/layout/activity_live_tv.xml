<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#020611">
 <LinearLayout android:id="@+id/live_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:id="@+id/live_player_column" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="#03070B">
   <FrameLayout android:id="@+id/live_player_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000" android:clipChildren="true" android:clipToPadding="true">
    <androidx.media3.ui.PlayerView android:id="@+id/live_player" android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true" app:resize_mode="fit" app:surface_type="surface_view" app:use_controller="false" app:show_buffering="never"/>
    <ImageView android:id="@+id/live_loading_logo" android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="center" android:scaleType="fitCenter" android:visibility="gone"/>
    <LinearLayout android:id="@+id/live_idle" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:id="@+id/live_idle_logo" android:layout_width="84dp" android:layout_height="84dp" android:scaleType="fitCenter"/><TextView android:text="Zgjidh një kanal" android:textColor="#DDE7F0" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
   </FrameLayout>
   <LinearLayout android:id="@+id/live_portrait_controls" android:layout_width="match_parent" android:layout_height="72dp" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:background="#071522">
    <LinearLayout android:layout_width="match_parent" android:layout_height="27dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/live_title" android:text="LazyTV PRO • LIVE TV" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><TextView android:id="@+id/live_epg" android:text="EPG" android:maxLines="1" android:ellipsize="end" android:textColor="#AFC6D8" android:textSize="10sp" android:gravity="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center"><Button android:id="@+id/live_prev" android:text="CH−" android:textAllCaps="false" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp"/><Button android:id="@+id/live_favorite" android:text="☆ Favorite" android:textAllCaps="false" android:focusable="true" android:layout_marginStart="3dp" android:layout_width="0dp" android:layout_weight="2" android:layout_height="38dp"/><Button android:id="@+id/live_next" android:text="CH+" android:textAllCaps="false" android:focusable="true" android:layout_marginStart="3dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp"/></LinearLayout>
   </LinearLayout>
   <View android:id="@+id/live_info" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/live_top_bar" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="3dp" android:paddingEnd="3dp" android:background="#071426">
   <ImageView android:id="@+id/live_brand_logo" android:layout_width="44dp" android:layout_height="38dp" android:scaleType="fitCenter"/>
   <Button android:id="@+id/live_nav_live" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="LIVE TV" android:textColor="#19D7FF" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_home_tile"/>
   <Button android:id="@+id/live_nav_movies" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="MOVIES" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_home_tile"/>
   <Button android:id="@+id/live_nav_series" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="SERIES" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_home_tile"/>
   <Button android:id="@+id/live_nav_islam" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="ISLAM" android:textColor="#E7C86B" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/bg_home_tile"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/live_content_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="3dp">
   <LinearLayout android:id="@+id/live_left_panel" android:layout_width="match_parent" android:layout_height="160dp" android:orientation="horizontal" android:background="#071522" android:padding="3dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical"><TextView android:text="COUNTRY" android:textColor="#18D7FF" android:textStyle="bold" android:textSize="10sp" android:layout_width="match_parent" android:layout_height="20dp"/><Spinner android:id="@+id/live_country_spinner" android:focusable="true" android:spinnerMode="dropdown" android:background="@drawable/bg_input" android:layout_width="match_parent" android:layout_height="52dp"/></LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:orientation="vertical"><TextView android:text="CATEGORIES" android:textColor="#18D7FF" android:textStyle="bold" android:textSize="10sp" android:layout_width="match_parent" android:layout_height="20dp"/><ListView android:id="@+id/live_categories" android:listSelector="@drawable/bg_live_row" android:divider="#173047" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
   </LinearLayout>
   <LinearLayout android:id="@+id/live_channel_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="#091A2C" android:layout_marginTop="3dp" android:padding="3dp">
    <TextView android:text="CHANNELS" android:textColor="#18D7FF" android:textStyle="bold" android:textSize="10sp" android:layout_width="match_parent" android:layout_height="18dp"/>
    <EditText android:id="@+id/live_search" android:hint="Search channels…" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#7890A7" android:background="@drawable/bg_input" android:padding="6dp" android:layout_width="match_parent" android:layout_height="38dp"/>
    <ListView android:id="@+id/live_channels" android:listSelector="@drawable/bg_live_row" android:divider="#173047" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
   </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/live_bottom_bar" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center_vertical" android:text="LazyTV PRO • LIVE TV" android:textColor="#71859A" android:textSize="8sp" android:background="#06111E"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/live_overlay" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="8dp" android:background="#F007121D"><LinearLayout android:layout_width="0dp" android:layout_weight="38" android:layout_height="match_parent" android:orientation="vertical"><TextView android:text="CATEGORIES" android:textColor="#18D7FF" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/overlay_categories" android:listSelector="@drawable/bg_live_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="62" android:layout_height="match_parent" android:orientation="vertical"><TextView android:text="CHANNELS" android:textColor="#18D7FF" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/overlay_channels" android:listSelector="@drawable/bg_live_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout></LinearLayout>
 <TextView android:id="@+id/live_status" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</FrameLayout>