<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lazytv_background" android:padding="8dp">
 <LinearLayout android:id="@+id/live_workspace" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
  <LinearLayout android:id="@+id/live_browser" android:layout_width="585dp" android:layout_height="match_parent" android:orientation="horizontal">
   <LinearLayout android:id="@+id/live_country_panel" android:layout_width="145dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#081522"><TextView android:text="COUNTRIES" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/live_countries" android:listSelector="@drawable/bg_live_row" android:divider="#173047" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
   <LinearLayout android:id="@+id/live_category_panel" android:layout_width="190dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#0A1928"><TextView android:text="CATEGORIES" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/live_categories" android:listSelector="@drawable/bg_live_row" android:divider="#173047" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
   <LinearLayout android:id="@+id/live_channel_panel" android:layout_width="250dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#0C1D2D"><EditText android:id="@+id/live_search" android:hint="Search channels…" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#8198AB" android:background="@drawable/bg_input" android:padding="10dp" android:layout_width="match_parent" android:layout_height="46dp"/><ListView android:id="@+id/live_channels" android:listSelector="@drawable/bg_live_row" android:divider="#173047" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
  </LinearLayout>
  <FrameLayout android:id="@+id/live_player_panel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="#000000">
   <androidx.media3.ui.PlayerView android:id="@+id/live_player" android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true" app:use_controller="true" app:show_buffering="when_playing"/>
   <ProgressBar android:id="@+id/live_loading" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:visibility="gone"/>
   <LinearLayout android:id="@+id/live_info" android:layout_gravity="bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="#C0000000">
    <TextView android:id="@+id/live_title" android:text="Zgjidh një kanal" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/live_epg" android:text="EPG shfaqet kur ofrohet nga burimi" android:maxLines="3" android:ellipsize="end" android:textColor="@color/lazytv_muted" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start"><Button android:id="@+id/live_favorite" android:text="☆ Favorite" android:textAllCaps="false" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/live_fullscreen" android:text="⛶ Fullscreen" android:textAllCaps="false" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
   </LinearLayout>
  </FrameLayout>
 </LinearLayout>
 <TextView android:id="@+id/live_status" android:textColor="@color/lazytv_muted" android:padding="6dp" android:maxLines="1" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>