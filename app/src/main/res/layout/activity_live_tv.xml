<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lazytv_background" android:padding="8dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
  <LinearLayout android:layout_width="145dp" android:layout_height="match_parent" android:orientation="vertical"><TextView android:text="COUNTRIES" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/live_countries" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
  <LinearLayout android:layout_width="190dp" android:layout_height="match_parent" android:orientation="vertical"><TextView android:text="CATEGORIES" android:textColor="@color/lazytv_accent" android:textStyle="bold" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><ListView android:id="@+id/live_categories" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
  <LinearLayout android:layout_width="250dp" android:layout_height="match_parent" android:orientation="vertical"><EditText android:id="@+id/live_search" android:hint="Search channels…" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#8198AB" android:background="@drawable/bg_input" android:padding="10dp" android:layout_width="match_parent" android:layout_height="46dp"/><ListView android:id="@+id/live_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
  <FrameLayout android:id="@+id/live_player_panel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="#000000">
   <androidx.media3.ui.PlayerView android:id="@+id/live_player" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="true"/>
   <LinearLayout android:id="@+id/live_info" android:layout_gravity="bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="#B0000000">
    <TextView android:id="@+id/live_title" android:text="Zgjidh një kanal" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/live_epg" android:textColor="@color/lazytv_muted" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/live_favorite" android:text="☆ Favorite" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/live_fullscreen" android:text="⛶ Fullscreen" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
   </LinearLayout>
  </FrameLayout>
 </LinearLayout>
 <TextView android:id="@+id/live_status" android:textColor="@color/lazytv_muted" android:padding="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>