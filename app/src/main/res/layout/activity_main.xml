<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/lazytv_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageView android:id="@+id/home_logo" android:layout_width="130dp" android:layout_height="130dp" android:scaleType="centerInside"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp">
   <TextView android:text="LazyTV PRO" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:text="LIVE TV  •  MOVIES  •  SERIES" android:textColor="@color/lazytv_accent" android:textSize="14sp" android:letterSpacing=".12" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
   <TextView android:id="@+id/home_device" android:textColor="@color/lazytv_muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/home_serial" android:textColor="@color/lazytv_muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <Button android:id="@+id/home_activate" android:text="Activate Device" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
 </LinearLayout>
 <GridLayout android:id="@+id/home_grid" android:columnCount="4" android:useDefaultMargins="true" android:alignmentMode="alignMargins" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
  <Button android:id="@+id/home_live" android:text="▶  LIVE TV" style="@style/HomeTile"/>
  <Button android:id="@+id/home_movies" android:text="▣  MOVIES" style="@style/HomeTile"/>
  <Button android:id="@+id/home_series" android:text="▤  SERIES" style="@style/HomeTile"/>
  <Button android:id="@+id/home_favorites" android:text="★  FAVORITES" style="@style/HomeTile"/>
  <Button android:id="@+id/home_search" android:text="⌕  SEARCH" style="@style/HomeTile"/>
  <Button android:id="@+id/manage_playlists" android:text="＋  MY PLAYLISTS" style="@style/HomeTile"/>
  <Button android:id="@+id/home_settings" android:text="⚙  SETTINGS" style="@style/HomeTile"/>
 </GridLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="14dp" android:background="@drawable/bg_card" android:gravity="center_vertical">
  <ImageView android:id="@+id/playlist_art" android:layout_width="100dp" android:layout_height="100dp" android:scaleType="centerCrop"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp">
   <TextView android:text="MY PLAYLISTS / SERVERS" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:text="Xtream Codes  •  M3U  •  Stalker Portal" android:textColor="@color/lazytv_muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout></ScrollView>