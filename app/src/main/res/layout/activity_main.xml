<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/lazytv_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageView android:id="@+id/home_logo" android:layout_width="86dp" android:layout_height="86dp" android:scaleType="centerInside"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LazyTV PRO" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIVE TV • MOVIES • SERIES" android:maxLines="1" android:ellipsize="end" android:textColor="@color/lazytv_accent" android:textSize="12sp"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" android:padding="12dp" android:background="@drawable/bg_card">
  <TextView android:id="@+id/home_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:textColor="#FFFFFF" android:textSize="12sp"/>
  <TextView android:id="@+id/home_serial" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:layout_marginTop="4dp" android:textColor="@color/lazytv_muted" android:textSize="12sp"/>
  <Button android:id="@+id/home_activate" android:layout_width="150dp" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Activate Device" android:textAllCaps="false"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp"><Button android:id="@+id/home_live" style="@style/HomeTilePortrait" android:text="LIVE TV" android:drawableTop="@drawable/ic_home_live" android:drawablePadding="6dp"/><Space android:layout_width="10dp" android:layout_height="1dp"/><Button android:id="@+id/home_movies" style="@style/HomeTilePortrait" android:text="MOVIES" android:drawableTop="@drawable/ic_home_movies" android:drawablePadding="6dp"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/home_series" style="@style/HomeTilePortrait" android:text="SERIES" android:drawableTop="@drawable/ic_home_series" android:drawablePadding="6dp"/><Space android:layout_width="10dp" android:layout_height="1dp"/><Button android:id="@+id/home_favorites" style="@style/HomeTilePortrait" android:text="★  FAVORITES"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/home_search" style="@style/HomeTilePortrait" android:text="⌕  SEARCH"/><Space android:layout_width="10dp" android:layout_height="1dp"/><Button android:id="@+id/manage_playlists" style="@style/HomeTilePortrait" android:text="＋  MY PLAYLISTS"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/home_settings" style="@style/HomeTilePortrait" android:text="⚙  SETTINGS"/><Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="ISLAMIC MEDIA" android:textColor="@color/lazytv_accent" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/home_islam_films" style="@style/HomeTilePortrait" android:text="FILMA ISLAM"/><Space android:layout_width="10dp" android:layout_height="1dp"/><Button android:id="@+id/home_islam_series" style="@style/HomeTilePortrait" android:text="FILMA SERIK ISLAM"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/home_lectures" style="@style/HomeTilePortrait" android:text="LIGJËRATA ISLAME"/><Space android:layout_width="10dp" android:layout_height="1dp"/><Button android:id="@+id/home_docs" style="@style/HomeTilePortrait" android:text="DOKUMENTARE ISLAME"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/home_kids" style="@style/HomeTilePortrait" android:text="FILMA VIZATIMOR ISLAM"/><Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="10dp" android:background="@drawable/bg_card" android:gravity="center_vertical">
  <ImageView android:id="@+id/playlist_art" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MY PLAYLISTS / SERVERS" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xtream • M3U • Stalker" android:maxLines="1" android:textColor="@color/lazytv_muted" android:textSize="12sp"/></LinearLayout>
 </LinearLayout>
</LinearLayout></ScrollView>