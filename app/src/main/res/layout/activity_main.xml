<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/lazytv_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/home_logo" android:layout_width="78dp" android:layout_height="78dp"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LazyTV PRO" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SIMPLE. STABLE. PREMIUM." android:textColor="@color/lazytv_accent" android:textSize="11sp"/></LinearLayout></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:padding="10dp" android:background="@drawable/bg_card"><TextView android:id="@+id/home_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/home_serial" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lazytv_muted" android:textSize="12sp"/><Button android:id="@+id/home_activate" android:layout_width="150dp" android:layout_height="42dp" android:layout_marginTop="6dp" android:text="Activate Device" android:textAllCaps="false"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:orientation="horizontal" android:layout_marginTop="10dp"><ImageButton android:id="@+id/home_live" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Live TV"/><ImageButton android:id="@+id/home_movies" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Movie"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:orientation="horizontal" android:layout_marginTop="6dp"><ImageButton android:id="@+id/home_series" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Seriale"/><Button android:id="@+id/home_favorites" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:text="★ FAVORITES" android:textColor="#FFFFFF"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/home_search" style="@style/HomeTilePortrait" android:text="▶ PLAYER"/><Space android:layout_width="6dp" android:layout_height="1dp"/><Button android:id="@+id/manage_playlists" style="@style/HomeTilePortrait" android:text="＋ PLAYLISTS"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:orientation="horizontal" android:layout_marginTop="6dp"><Button android:id="@+id/home_settings" style="@style/HomeTilePortrait" android:text="⚙ SETTINGS"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:padding="5dp" android:background="@drawable/bg_card"><ImageView android:id="@+id/playlist_art" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="fitCenter"/></LinearLayout></LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ISLAMIC MEDIA" android:textColor="@color/lazytv_accent" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="130dp" android:orientation="horizontal" android:layout_marginTop="6dp"><ImageButton android:id="@+id/home_islam_films" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Filma Islam"/><ImageButton android:id="@+id/home_islam_series" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Filma Serik Islam"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="130dp" android:orientation="horizontal" android:layout_marginTop="6dp"><ImageButton android:id="@+id/home_lectures" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Ligjerata Islame"/><ImageButton android:id="@+id/home_docs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Dokumentare Islame"/></LinearLayout>
 <ImageButton android:id="@+id/home_kids" android:layout_width="match_parent" android:layout_height="140dp" android:layout_margin="3dp" android:background="@drawable/bg_card" android:scaleType="fitCenter" android:contentDescription="Filma Vizatimor Islam"/>
</LinearLayout></ScrollView>