<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/lazytv_background" android:padding="14dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:id="@+id/catalog_title" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/catalog_search" android:layout_width="260dp" android:layout_height="48dp" android:hint="Search…" android:singleLine="true" android:textColor="#FFFFFF" android:hintTextColor="#8298AA" android:background="@drawable/bg_input" android:paddingHorizontal="14dp" android:focusable="true"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
  <Button android:id="@+id/tab_live" android:text="LIVE TV" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:focusable="true"/>
  <Button android:id="@+id/tab_movies" android:text="MOVIES" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:focusable="true"/>
  <Button android:id="@+id/tab_series" android:text="SERIES" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:focusable="true"/>
  <Button android:id="@+id/tab_favorites" android:text="★ FAVORITES" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:focusable="true"/>
 </LinearLayout>
 <TextView android:id="@+id/catalog_breadcrumb" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="9dp" android:textColor="@color/lazytv_accent" android:textStyle="bold"/>
 <ProgressBar android:id="@+id/catalog_progress" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/catalog_status" android:textColor="@color/lazytv_muted" android:padding="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <ListView android:id="@+id/catalog_list" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp" android:focusable="true"/>
</LinearLayout>