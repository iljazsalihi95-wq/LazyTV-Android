<resources>
<style name="Theme.LazyTVPRO" parent="android:style/Theme.Material.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:windowActionModeOverlay">true</item><item name="android:colorAccent">#55B8FF</item><item name="android:navigationBarColor">@color/lazytv_background</item><item name="android:statusBarColor">@color/lazytv_background</item></style>
<style name="LazyInput" parent="android:style/Widget.Material.EditText"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:layout_marginTop">12dp</item><item name="android:paddingLeft">12dp</item><item name="android:paddingRight">12dp</item><item name="android:textColor">#FFFFFF</item><item name="android:textColorHint">#8EA8BE</item><item name="android:background">@drawable/bg_input</item><item name="android:singleLine">true</item></style>
<style name="HomeTileBase" parent="@android:style/Widget.Button"><item name="android:background">@drawable/bg_home_tile</item><item name="android:textColor">#FFFFFF</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:maxLines">1</item><item name="android:ellipsize">end</item><item name="android:focusable">true</item><item name="android:clickable">true</item><item name="android:gravity">center</item><item name="android:paddingLeft">8dp</item><item name="android:paddingRight">8dp</item></style>
<style name="HomeTilePortrait" parent="HomeTileBase"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">76dp</item></style>
<style name="HomeTileLandscape" parent="HomeTileBase"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">82dp</item></style>
<style name="HomeGap"><item name="android:layout_width">10dp</item><item name="android:layout_height">1dp</item></style>
</resources>