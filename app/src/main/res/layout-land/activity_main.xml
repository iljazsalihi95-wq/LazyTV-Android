<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/lazytv_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="110dp" android:gravity="center_vertical">
  <ImageView android:id="@+id/home_logo" android:layout_width="100dp" android:layout_height="100dp" android:scaleType="centerInside"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LazyTV PRO" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIVE TV • MOVIES • SERIES" android:maxLines="1" android:textColor="@color/lazytv_accent" android:textSize="13sp"/></LinearLayout>
  <LinearLayout android:layout_width="270dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_card"><TextView android:id="@+id/home_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:textColor="#FFFFFF" android:textSize="11sp"/><TextView android:id="@+id/home_serial" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:textColor="@color/lazytv_muted" android:textSize="11sp"/><Button android:id="@+id/home_activate" android:layout_width="140dp" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="Activate Device" android:textAllCaps="false"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/home_live" style="@style/HomeTileLandscape" android:text="📺  LIVE TV"/><Space style="@style/HomeGap"/><Button android:id="@+id/home_movies" style="@style/HomeTileLandscape" android:text="🎬  MOVIES"/><Space style="@style/HomeGap"/><Button android:id="@+id/home_series" style="@style/HomeTileLandscape" android:text="🎞  SERIES"/><Space style="@style/HomeGap"/><Button android:id="@+id/home_favorites" style="@style/HomeTileLandscape" android:text="★  FAVORITES"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/home_search" style="@style/HomeTileLandscape" android:text="⌕  SEARCH"/><Space style="@style/HomeGap"/><Button android:id="@+id/manage_playlists" style="@style/HomeTileLandscape" android:text="＋  MY PLAYLISTS"/><Space style="@style/HomeGap"/><Button android:id="@+id/home_settings" style="@style/HomeTileLandscape" android:text="⚙  SETTINGS"/><Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="14dp" android:padding="10dp" android:background="@drawable/bg_card" android:gravity="center_vertical"><ImageView android:id="@+id/playlist_art" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MY PLAYLISTS / SERVERS" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xtream Codes • M3U • Stalker Portal" android:maxLines="1" android:textColor="@color/lazytv_muted"/></LinearLayout></LinearLayout>
</LinearLayout></ScrollView>