<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="22dp" android:background="@color/lazytv_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="104dp" android:gravity="center_vertical">
  <ImageView android:id="@+id/home_logo" android:layout_width="92dp" android:layout_height="92dp" android:scaleType="centerInside"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LazyTV PRO" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SIMPLE. STABLE. PREMIUM." android:textColor="@color/lazytv_accent" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
  <LinearLayout android:layout_width="280dp" android:layout_height="88dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_card"><TextView android:id="@+id/home_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:textColor="#FFFFFF" android:textSize="11sp"/><TextView android:id="@+id/home_serial" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:textColor="@color/lazytv_muted" android:textSize="11sp"/><Button android:id="@+id/home_activate" android:layout_width="150dp" android:layout_height="38dp" android:text="Activate Device" android:textAllCaps="false"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
  <Button android:id="@+id/home_live" style="@style/HomeTileLandscape" android:layout_height="match_parent" android:text="📺\nLIVE TV" android:textSize="22sp"/>
  <Space style="@style/HomeGap"/>
  <Button android:id="@+id/home_movies" style="@style/HomeTileLandscape" android:layout_height="match_parent" android:text="🎬\nMOVIES" android:textSize="22sp"/>
  <Space style="@style/HomeGap"/>
  <Button android:id="@+id/home_series" style="@style/HomeTileLandscape" android:layout_height="match_parent" android:text="🎞\nSERIES" android:textSize="22sp"/>
  <Space style="@style/HomeGap"/>
  <Button android:id="@+id/home_favorites" style="@style/HomeTileLandscape" android:layout_height="match_parent" android:text="★\nFAVORITES" android:textSize="20sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:layout_marginTop="12dp">
  <Button android:id="@+id/home_search" style="@style/HomeTileLandscape" android:text="▶  PLAYER I LIRË"/>
  <Space style="@style/HomeGap"/>
  <Button android:id="@+id/manage_playlists" style="@style/HomeTileLandscape" android:text="＋  MY PLAYLISTS"/>
  <Space style="@style/HomeGap"/>
  <Button android:id="@+id/home_settings" style="@style/HomeTileLandscape" android:text="⚙  SETTINGS"/>
  <Space style="@style/HomeGap"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="8dp" android:background="@drawable/bg_card" android:gravity="center_vertical"><ImageView android:id="@+id/playlist_art" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop"/><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="8dp" android:text="M3U URL/File • Xtream Codes • Stalker Portal" android:textColor="@color/lazytv_muted" android:textSize="12sp"/></LinearLayout>
 </LinearLayout>
</LinearLayout>