<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@color/lazytv_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:gravity="center_vertical">
  <ImageView android:id="@+id/home_logo" android:layout_width="86dp" android:layout_height="86dp" android:scaleType="centerInside"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LazyTV PRO" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SIMPLE. STABLE. PREMIUM." android:textColor="@color/lazytv_accent" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
  <LinearLayout android:layout_width="280dp" android:layout_height="88dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_card"><TextView android:id="@+id/home_device" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="11sp"/><TextView android:id="@+id/home_serial" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/lazytv_muted" android:textSize="11sp"/><Button android:id="@+id/home_activate" android:layout_width="150dp" android:layout_height="38dp" android:text="Activate Device" android:textAllCaps="false"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="130dp" android:orientation="horizontal" android:layout_marginTop="8dp">
  <ImageButton android:id="@+id/home_live" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="@drawable/bg_card" android:padding="5dp" android:scaleType="fitCenter" android:contentDescription="Live TV"/>
  <ImageButton android:id="@+id/home_movies" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="@drawable/bg_card" android:padding="5dp" android:scaleType="fitCenter" android:contentDescription="Movie"/>
  <ImageButton android:id="@+id/home_series" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="@drawable/bg_card" android:padding="5dp" android:scaleType="fitCenter" android:contentDescription="Seriale"/>
  <Button android:id="@+id/home_favorites" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="@drawable/bg_card" android:text="★ FAVORITES" android:textColor="#FFFFFF" android:textSize="16sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:layout_marginTop="8dp">
  <Button android:id="@+id/home_search" style="@style/HomeTileLandscape" android:text="▶ PLAYER I LIRË"/><Space style="@style/HomeGap"/><Button android:id="@+id/manage_playlists" style="@style/HomeTileLandscape" android:text="＋ MY PLAYLISTS"/><Space style="@style/HomeGap"/><Button android:id="@+id/home_settings" style="@style/HomeTileLandscape" android:text="⚙ SETTINGS"/><Space style="@style/HomeGap"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:padding="6dp" android:background="@drawable/bg_card" android:gravity="center_vertical"><ImageView android:id="@+id/playlist_art" android:layout_width="50dp" android:layout_height="50dp" android:scaleType="fitCenter"/><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="8dp" android:text="M3U • Xtream • Stalker" android:textColor="@color/lazytv_muted" android:textSize="12sp"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="110dp" android:orientation="horizontal" android:layout_marginTop="8dp">
  <ImageButton android:id="@+id/home_islam_films" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="3dp" android:background="@drawable/bg_card" android:padding="4dp" android:scaleType="fitCenter" android:contentDescription="ISLAM"/>
  <ImageButton android:id="@+id/home_islam_series" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
  <ImageButton android:id="@+id/home_lectures" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
  <ImageButton android:id="@+id/home_docs" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
  <ImageButton android:id="@+id/home_kids" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
 </LinearLayout>
</LinearLayout>